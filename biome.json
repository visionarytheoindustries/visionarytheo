{
    "$schema": "https://biomejs.dev/schemas/latest/schema.json",
    "files": {
        "includes": ["**", "!node_modules", "!.next", "!dist", "!build", "!public"]
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "overrides": [
        {
            "includes": ["src/components/ui/**"],
            "linter": {
                "enabled": false
            }
        }
    ],
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
